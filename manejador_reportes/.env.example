# Note: Celery has been replaced by the Golang worker pool (worker_golang/).
# Event processing is handled by worker_golang consuming from RabbitMQ directly.
# The manejador_reportes Django service only PUBLISHES events via pika — it does
# not run any worker process itself.

# Django
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,manejador_reportes
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING

# PostgreSQL — variable names match terraform user_data injection
DATABASE_NAME=reportes_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=postgres_reportes
DATABASE_PORT=5432

# RabbitMQ — Django service publishes events; Golang worker_golang/ consumes
RABBITMQ_URL=amqp://bite:bite_pass@rabbitmq:5672/bite_vhost
RABBITMQ_EXCHANGE=bite_events

# Email notification (external provider)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=notificaciones@bite.co

# Auth + Security services (ASR2/ASR3)
AUTH_SERVICE_URL=http://manejador-autenticacion:8004
AUTH_SERVICE_TIMEOUT=2
SEGURIDAD_URL=http://manejador-seguridad:8005
LOCAL_JWT_SECRET=local-dev-jwt-secret-change-in-production

# API throttling
API_THROTTLE_ANON=5000/min

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
