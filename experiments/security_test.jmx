<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="4.0" jmeter="4.0 r1823414">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan"
              testname="BITE.co – ASR19 Security Experiment (Rate Limiting Trade-off)" enabled="true">
      <stringProp name="TestPlan.comments">
        ASR19 – Security Experiment: Rate Limiting Trade-off

        Measures the effect of RateLimitMiddleware on POST /projects in manejador_cloud.
        Rate limiter: Redis sliding window — 20 req / 10 s per client IP (configurable).
        Two phases, two thread groups — run one at a time.

        ================================================================
        HOW TO RUN:

        Phase 1 – Baseline WITHOUT rate limiting (ENABLE TG1, DISABLE TG2):
          SSH to manejador_cloud EC2:
            ssh -i &lt;key.pem&gt; ubuntu@&lt;cloud_ec2_ip&gt;
            sudo pkill -f "uvicorn main:app" || true; sleep 1
            cd /opt/biteco/manejador_cloud
            AUTH_DISABLED=true RATE_LIMIT_ENABLED=false \
              nohup uvicorn main:app --host 0.0.0.0 --port 8002 --workers 4 \
              &gt; /tmp/manejador_cloud.log 2&gt;&amp;1 &amp;
            sleep 3 &amp;&amp; curl -s http://localhost:8002/health

          Run from JMeter machine (ENABLE Thread Group 1, DISABLE Thread Group 2):
            jmeter -n -t experiments/security_test.jmx \
              -l results/asr19_baseline.jtl \
              -e -o results/asr19_baseline_report \
              -JALB_HOST=bite2-alb-409016959.us-east-1.elb.amazonaws.com

        Phase 2 – WITH rate limiting (DISABLE TG1, ENABLE TG2):
          SSH to manejador_cloud EC2:
            ssh -i &lt;key.pem&gt; ubuntu@&lt;cloud_ec2_ip&gt;
            sudo pkill -f "uvicorn main:app" || true; sleep 1
            cd /opt/biteco/manejador_cloud
            AUTH_DISABLED=true RATE_LIMIT_ENABLED=true \
              RATE_LIMIT_REQUESTS=20 RATE_LIMIT_WINDOW=10 \
              nohup uvicorn main:app --host 0.0.0.0 --port 8002 --workers 4 \
              &gt; /tmp/manejador_cloud.log 2&gt;&amp;1 &amp;
            sleep 3 &amp;&amp; curl -s http://localhost:8002/health

          Run from JMeter machine (DISABLE Thread Group 1, ENABLE Thread Group 2):
            jmeter -n -t experiments/security_test.jmx \
              -l results/asr19_protected.jtl \
              -e -o results/asr19_protected_report \
              -JALB_HOST=bite2-alb-409016959.us-east-1.elb.amazonaws.com

        After Phase 2, count blocked vs allowed:
          grep ",201," results/asr19_phase2_codes.csv | wc -l   # allowed
          grep ",429," results/asr19_phase2_codes.csv | wc -l   # blocked
          # blocked% = blocked / (blocked + allowed) * 100  — target: >= 90%

        Compare P95, average latency, and % of 429 responses between phases.
        Document the latency vs security trade-off (P95 of 201 responses in Phase 2
        must still be &lt;= 500 ms to confirm legitimate users are not degraded).
        ================================================================
      </stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <!-- serialize=true so TG1 and TG2 don't run simultaneously -->
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.arguments" elementType="Arguments" guiclass="ArgumentsPanel"
                   testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <!-- Override at runtime: -JALB_HOST=bite2-alb-XXXXXXX.us-east-1.elb.amazonaws.com -->
          <elementProp name="ALB_HOST" elementType="Argument">
            <stringProp name="Argument.name">ALB_HOST</stringProp>
            <stringProp name="Argument.value">${__P(ALB_HOST,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ================================================================ -->
      <!-- setUp: Authenticate and store JWT for both thread groups         -->
      <!-- ================================================================ -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup"
                        testname="setUp – Obtain JWT Token" enabled="true">
        <!-- continue: AUTH_DISABLED=true on manejador_cloud means JWT is not
             validated — a fallback bypass token is set if auth is unreachable -->
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
      </SetupThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                       testname="JSON Header" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="POST /auth/login" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"email":"empresa_a@bite.co","password":"BiteCo2024!"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(ALB_HOST,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">443</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/auth/login</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <intProp name="HTTPSampler.connect_timeout">10000</intProp>
          <intProp name="HTTPSampler.response_timeout">10000</intProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Extract and promote jwt_token variable to a global property using Groovy -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor"
                               testname="Extract and Promote JWT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// AUTH_DISABLED=true on manejador_cloud — JWT is not validated.
// Fall back to a bypass token so the test runs even if auth service is down.
def response = prev.getResponseDataAsString()
try {
    def json = new JsonSlurper().parseText(response)
    def token = json.access_token
    if (token) {
        props.put("jwt_token", token)
        log.info("JWT extracted: " + token.take(20) + "...")
    } else {
        props.put("jwt_token", "AUTH_DISABLED_BYPASS")
        log.warn("access_token not found — using AUTH_DISABLED_BYPASS token")
    }
} catch (Exception e) {
    props.put("jwt_token", "AUTH_DISABLED_BYPASS")
    log.warn("Auth login failed (" + e.getMessage() + ") — using AUTH_DISABLED_BYPASS token")
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ================================================================ -->
      <!-- Thread Group 1: Phase 1 — Baseline (20 users, no rate limit)    -->
      <!-- ENABLE this group / DISABLE Group 2 for Phase 1                 -->
      <!-- Expected: ~100% HTTP 201, low latency overhead                  -->
      <!-- ================================================================ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup"
                   testname="Phase 1 – Baseline 20 Users (no rate limit)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlPanel" testclass="LoopController" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">10</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">20</stringProp>
        <stringProp name="ThreadGroup.ramp_time">15</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>

        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                       testname="HTTP Headers – Phase 1" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
