            <collectionProp name="Assertion.test_strings">
              <stringProp name="49586">201</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Phase 1 baseline: expected HTTP 201 with no rate limiting</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- Phase 1 latency baseline -->
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
