# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://bite:bite_pass@rabbitmq:5672/bite_vhost

# ── PostgreSQL (reportes_db) ─────────────────────────────────────────────────
DATABASE_HOST=postgres_reportes
DATABASE_PORT=5432
DATABASE_NAME=reportes_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_MAX_CONNS=20

# ── Worker pool ───────────────────────────────────────────────────────────────
# Number of concurrent message-handler goroutines.
# Also controls AMQP prefetch count so each goroutine holds at most 1 message.
WORKER_CONCURRENCY=10

# ── Health server ─────────────────────────────────────────────────────────────
PORT=8006

# ── ASR15 demo ────────────────────────────────────────────────────────────────
# Set to "true" to sleep 3s during event processing (triggers slow-path notification)
SIMULATE_SLOW_PROCESSING=false
