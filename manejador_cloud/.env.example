# PostgreSQL — write path (primary RDS, main.tf DATABASE_HOST)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cloud_db
DATABASE_USER=admin
DATABASE_PASSWORD=admin123

# PostgreSQL — read path (RDS read replica, main.tf DATABASE_READ_HOST)
# Defaults to DATABASE_HOST when not set (local dev has no replica)
DATABASE_READ_HOST=localhost

# Redis (DB index 1 — dashboard cache, 30 s TTL)
REDIS_URL=redis://redis:6379/1
CLOUD_CACHE_TTL=30

# Auth service (manejador_autenticacion)
AUTH_SERVICE_URL=http://manejador-autenticacion:8004
AUTH_SERVICE_TIMEOUT=2
LOCAL_JWT_SECRET=local-dev-jwt-secret-change-in-production

# uvicorn
PORT=8002
LOG_LEVEL=INFO
DB_ECHO=false
